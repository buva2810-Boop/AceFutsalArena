<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book Court"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#14532D"/>

        <TextView
            android:id="@+id/txtSelectedCourt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Court A • RM 120/hour"
            android:textColor="#64748B"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Select Date"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1E293B"/>

        <CalendarView
            android:id="@+id/calendarView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Select Time Slot"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1E293B"/>

        <RadioGroup
            android:id="@+id/timeSlotGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <RadioButton
                android:id="@+id/radio1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="9:00 AM - 10:00 AM"
                android:textSize="16sp"/>

            <RadioButton
                android:id="@+id/radio2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="10:00 AM - 11:00 AM"
                android:textSize="16sp"/>

            <RadioButton
                android:id="@+id/radio3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="11:00 AM - 12:00 PM"
                android:textSize="16sp"/>

            <RadioButton
                android:id="@+id/radio4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2:00 PM - 3:00 PM"
                android:textSize="16sp"/>

            <RadioButton
                android:id="@+id/radio5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3:00 PM - 4:00 PM"
                android:textSize="16sp"/>

            <RadioButton
                android:id="@+id/radio6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4:00 PM - 5:00 PM"
                android:textSize="16sp"/>

            <RadioButton
                android:id="@+id/radio7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5:00 PM - 6:00 PM"
                android:textSize="16sp"/>

            <RadioButton
                android:id="@+id/radio8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6:00 PM - 7:00 PM"
                android:textSize="16sp"/>

            <RadioButton
                android:id="@+id/radio9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="7:00 PM - 8:00 PM"
                android:textSize="16sp"/>

            <RadioButton
                android:id="@+id/radio10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="8:00 PM - 9:00 PM"
                android:textSize="16sp"/>

            <RadioButton
                android:id="@+id/radio11"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="9:00 PM - 10:00 PM"
                android:textSize="16sp"/>

            <RadioButton
                android:id="@+id/radio12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="10:00 PM - 11:00 PM"
                android:textSize="16sp"/>

            <RadioButton
                android:id="@+id/radio13"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="11:00 PM - 12:00 AM"
                android:textSize="16sp"/>

        </RadioGroup>

        <TextView
            android:id="@+id/txtTotalPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Total: RM 120"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#14532D"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmBooking"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:text="CONFIRM BOOKING"
            android:textStyle="bold"
            android:backgroundTint="#14532D"
            app:cornerRadius="14dp"/>

    </LinearLayout>

</ScrollView>